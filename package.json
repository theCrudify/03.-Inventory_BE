{
  "name": "inventory-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
