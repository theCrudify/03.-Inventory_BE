# ============================================================================
# Konfigurasi lokal. Salin menjadi `.env` (berkas ini TIDAK ikut ter-commit).
#   cp .env.example .env
# Dipakai oleh: npm run dev, db:push, db:seed, npm test, dan wrangler dev.
# Produksi (Cloudflare): nilai biasa di wrangler.toml [vars], rahasia lewat
#   npx wrangler secret put DATABASE_URL   /   npx wrangler secret put JWT_SECRET
# ============================================================================

# ── Server lokal (hanya untuk `npm run dev`) ────────────────────────────────
PORT=8787
# 127.0.0.1 = hanya komputer ini. Isi 0.0.0.0 agar bisa dibuka dari perangkat lain di jaringan.
HOST=127.0.0.1

# ── Wajib ───────────────────────────────────────────────────────────────────
# Karakter khusus di password harus di-encode: ! = %21  @ = %40  # = %23  $ = %24
DATABASE_URL=postgres://user:password@localhost:5432/new_inventory
# Minimal 32 karakter acak, mis.:  openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ── CORS: alamat frontend yang boleh memanggil API (pisahkan dengan koma) ───
# Hanya origin (skema + host + port), tanpa path dan tanpa garis miring di akhir.
CORS_ORIGINS=http://localhost:3000
# Khusus pengembangan: izinkan http://localhost:<port apa pun> tanpa daftar manual. Jangan true di produksi.
CORS_ALLOW_LOCALHOST=true

# ── Opsional (nilai di bawah adalah bawaan) ─────────────────────────────────
# Masa berlaku sesi login, dalam jam (1-72)
TOKEN_TTL_HOURS=8
# Pembatasan percobaan login: gagal sebanyak ini dalam jendela waktu akan mengunci
LOGIN_MAX_PER_CLIENT=5      # email yang sama dari alamat yang sama
LOGIN_MAX_PER_EMAIL=20      # email yang sama dari mana saja
LOGIN_WINDOW_MIN=15         # jendela hitung kegagalan (menit)
LOGIN_LOCK_MIN=15           # lama terkunci (menit)
# Ukuran maksimal body permintaan, dalam KB (1-10240)
BODY_LIMIT_KB=256
